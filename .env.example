# Recall.ai API Key (required)
# Get it from: https://us-west-2.recall.ai/dashboard/developers/api-keys
RECALL_API_KEY=

# OpenAI API Key (optional - for AI summaries)
# Without this, the app will use basic keyword-based summaries
OPENAI_API_KEY=

# Server ports (optional - defaults shown)
PORT=3000
WEBSOCKET_PORT=3456
