# Recall.ai API key (optional; required only for visible bot capture)
# Get it from: https://us-west-2.recall.ai/dashboard/developers/api-keys
RECALL_API_KEY=

# OpenAI API Key (optional - for AI summaries)
# Without this, the app will use basic keyword-based summaries
OPENAI_API_KEY=

# Server ports (optional - defaults shown)
PORT=3000
WEBSOCKET_PORT=3456

# Meeting-specific assistant model
ASSISTANT_MODEL=gpt-4o-mini

# Local-only binding; the app has no user authentication
HOST=127.0.0.1
RECALL_HOST=127.0.0.1

# Optional SQLite database override
# DATABASE_PATH=/absolute/path/to/meetings.db
